[gd_resource type="Gradient" format=3]

; 世界整体色调（喂给 CanvasModulate）。横轴 = 昼夜进度 0~1。
; 白色 = 原样，越暗越"夜"。Alpha 请保持 1。
;
; 想要"啪一下天黑"：把 0.72 和 0.80 这两个色标拖到一起（比如 0.75 / 0.755）。
; 想要慢慢黑：把它们拉开（比如 0.62 / 0.88）。

[resource]
offsets = PackedFloat32Array(0, 0.18, 0.25, 0.72, 0.8, 1)
colors = PackedColorArray(0.52, 0.56, 0.75, 1, 0.52, 0.56, 0.75, 1, 1, 1, 1, 1, 1, 1, 1, 1, 0.52, 0.56, 0.75, 1, 0.52, 0.56, 0.75, 1)
