[sub_resource type="GDScript" id="GDScript_nb64h"]
script/source = "extends Control

# 假设你的 BGM 在音频总线（Bus）的第 1 条，音效在第 2 条
# 你可以在编辑器最下方的 Audio 面板里查看或添加
var bgm_bus_index = AudioServer.get_bus_index(\"Master\") 
const CONFIRM_DIALOG = preload(\"res://scenes/sidebar/confirm_dialog.tscn\")

func _on_bgm_slider_value_changed(value):
	# value 通常是 0 到 100，我们需要把它转成音量分贝
	# linear_to_db 是 Godot 自带的函数
	AudioServer.set_bus_volume_db(bgm_bus_index, linear_to_db(value / 100.0))

func _on_fullscreen_toggled(toggled_on):
	# 使用“屏幕管家”切换全屏
	if toggled_on:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)

func _on_npc_name_toggled(toggled_on):
	# 这里你可以设置一个全局变量，或者发一个信号给你的游戏主逻辑
	print(\"NPC名字显示状态：\", toggled_on)

func _on_save_button_pressed():
	# 这里执行保存逻辑（比如存入文件）
	# 然后我们可以通过代码告诉侧边栏：“我点完了，你可以收起来了”
	# 为了简单，我们先只打印一句话
	print(\"设置已保存！\")

func _on_save__quit_pressed() -> void:
	# 1. 创建对话框
	var dialog_instance = CONFIRM_DIALOG.instantiate()

	# 2. 设置对话框文字（如果你的对话框脚本支持设置标题和内容）
	if dialog_instance.has_method(\"set_texts\"):
		dialog_instance.set_texts(\"保存并退出\", \"确定要保存当前进度并退出游戏吗？\")
	
	# 3. 核心：连接“确认”信号到执行函数
	# 使用 CONNECT_ONE_SHOT 确保信号只触发一次，防止意外重复执行
	dialog_instance.confirmed.connect(_execute_save_and_quit, CONNECT_ONE_SHOT)

	# 4. 加入场景树显示
	get_tree().root.add_child(dialog_instance)
	
func _execute_save_and_quit() -> void:
	# 1. 调用全局单例 SaveManager 进行存档
	# 这样可以确保玩家当前的 KPI、美金、员工位置和办公室状态都被写入 user://savegame.json
	if SaveManager.has_method(\"save_game\"):
		SaveManager.save_game()
		print(\"存档成功...\")
	else:
		push_error(\"错误：找不到 SaveManager 或 save_game 方法，请检查 Autoload 设置\")

	# 2. 稍微等待一帧或给个打印反馈（可选），然后彻底退出
	print(\"正在退出游戏...\")
	get_tree().quit()
	
func _on_delete_saave_pressed() -> void:
	pass


func _on_delete_save_pressed() -> void:
	# 直接调用全局单例中的删除方法
	if SaveManager.has_method(\"delete_save\"):
		SaveManager.delete_save()
	else:
		push_error(\"错误：在 SaveManager 中找不到 delete_save 方法\")
"

