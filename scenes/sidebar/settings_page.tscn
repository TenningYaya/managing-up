[sub_resource type="GDScript" id="GDScript_nb64h"]
script/source = "
extends Control

# BGM 走 Music 总线，其余音效走 SFX 总线（定义在 res://default_bus_layout.tres）
var music_bus_index = AudioServer.get_bus_index(\"Music\")
var sfx_bus_index = AudioServer.get_bus_index(\"SFX\")
const CONFIRM_DIALOG = preload(\"res://scenes/sidebar/confirm_dialog.tscn\")

@onready var _music_slider: HSlider = $\"Master Volume/HSlider\"
@onready var _sfx_slider: HSlider = $\"Sound Effects Volume/HSlider\"
var _settings_opened := false  # 是否已打开过设置页（避免加载阶段误存盘）

func _on_music_slider_value_changed(value: float) -> void:
	# value 范围 0~100，转换成分贝设置到 Music 总线（控制 BGM）
	AudioServer.set_bus_volume_db(music_bus_index, linear_to_db(value / 100.0))

func _on_sfx_slider_value_changed(value: float) -> void:
	# 控制所有音效（YesSound / NoSound / BubbleSound / ClickedSound 等）
	AudioServer.set_bus_volume_db(sfx_bus_index, linear_to_db(value / 100.0))

func _on_fullscreen_toggled(toggled_on):
	# 使用“屏幕管家”切换全屏
	if toggled_on:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)

func _on_npc_name_toggled(toggled_on):
	# 这里你可以设置一个全局变量，或者发一个信号给你的游戏主逻辑
	print(\"NPC名字显示状态：\", toggled_on)

func _on_save_button_pressed():
	# 这里执行保存逻辑（比如存入文件）
	# 然后我们可以通过代码告诉侧边栏：“我点完了，你可以收起来了”
	# 为了简单，我们先只打印一句话
	print(\"设置已保存！\")

func _on_save__quit_pressed() -> void:
	# 1. 创建对话框
	var dialog_instance = CONFIRM_DIALOG.instantiate()

	# 2. 设置对话框文字（如果你的对话框脚本支持设置标题和内容）
	if dialog_instance.has_method(\"set_texts\"):
		dialog_instance.set_texts(\"保存并退出\", \"确定要保存当前进度并退出游戏吗？\")
	
	# 3. 核心：连接“确认”信号到执行函数
	# 使用 CONNECT_ONE_SHOT 确保信号只触发一次，防止意外重复执行
	dialog_instance.confirmed.connect(_execute_save_and_quit, CONNECT_ONE_SHOT)

	# 4. 加入场景树显示
	get_tree().root.add_child(dialog_instance)
	
func _execute_save_and_quit() -> void:
	# 1. 调用全局单例 SaveManager 进行存档
	# 这样可以确保玩家当前的 KPI、美金、员工位置和办公室状态都被写入 user://savegame.json
	if SaveManager.has_method(\"save_game\"):
		SaveManager.save_game()
		print(\"存档成功...\")
	else:
		push_error(\"错误：找不到 SaveManager 或 save_game 方法，请检查 Autoload 设置\")

	# 退出前把音量设置也存下来
	_persist_audio_volumes()

	# 2. 稍微等待一帧或给个打印反馈（可选），然后彻底退出
	print(\"正在退出游戏...\")
	get_tree().quit()
	
func _on_delete_saave_pressed() -> void:
	pass


func _on_delete_save_pressed() -> void:
	# 直接调用全局单例中的删除方法
	if SaveManager.has_method(\"delete_save\"):
		SaveManager.delete_save()
	else:
		push_error(\"错误：在 SaveManager 中找不到 delete_save 方法\")

# —— Always on Top 勾选框 ——
func _ready() -> void:
	_sync_always_on_top_checkbox()
	_init_volume_sliders()
	_apply_translations()


func _apply_translations() -> void:
	$settings.text = tr(\"Sidebar_settings_title\")
	$\"Master Volume\".text = \"     \" + tr(\"Sidebar_settings_BGM_volume\")
	$\"Sound Effects Volume\".text = \"     \" + tr(\"Sidebar_settings_SFX_volume\")
	$\"Always on Top/Label\".text = \"     \" + tr(\"Sidebar_settings_always_on_top\")
	$\"Save & Quit/Label\".text = tr(\"Sidebar_settings_save_quit\")
	$\"Delete Save/Label\".text = tr(\"Sidebar_settings_delete_save\")


func _init_volume_sliders() -> void:
	# 设定范围并连接信号；滑块位置在每次打开设置时由 _sync_volume_sliders() 同步
	# （子节点 _ready 早于 Main._ready 读取存档，所以这里不能依赖最终音量）
	_music_slider.min_value = 0
	_music_slider.max_value = 100
	_sfx_slider.min_value = 0
	_sfx_slider.max_value = 100
	_sync_volume_sliders()
	if not _music_slider.value_changed.is_connected(_on_music_slider_value_changed):
		_music_slider.value_changed.connect(_on_music_slider_value_changed)
	if not _sfx_slider.value_changed.is_connected(_on_sfx_slider_value_changed):
		_sfx_slider.value_changed.connect(_on_sfx_slider_value_changed)

func _sync_volume_sliders() -> void:
	# 让滑块反映当前真实音量（启动时已从 settings.cfg 应用到总线，用 no_signal 避免误触发）
	_music_slider.set_value_no_signal(db_to_linear(AudioServer.get_bus_volume_db(music_bus_index)) * 100.0)
	_sfx_slider.set_value_no_signal(db_to_linear(AudioServer.get_bus_volume_db(sfx_bus_index)) * 100.0)

func _on_visibility_changed() -> void:
	if visible:
		_settings_opened = true
		_sync_always_on_top_checkbox()
		_sync_volume_sliders()
	elif _settings_opened:
		# 离开设置页时把音量存盘（避免拖动时每帧写文件）
		_persist_audio_volumes()

func _persist_audio_volumes() -> void:
	# 交给 Bgm autoload 持久化（音量在引擎启动时就由它应用，保证各场景一致）
	if Bgm and Bgm.has_method(\"save_audio_volumes\"):
		Bgm.save_audio_volumes()

func _sync_always_on_top_checkbox() -> void:
	# 让勾选框反映窗口当前真实的置顶状态（用 no_signal 避免触发 toggled）
	$\"Always on Top/CheckBox\".set_pressed_no_signal(
		DisplayServer.window_get_flag(DisplayServer.WINDOW_FLAG_ALWAYS_ON_TOP))

func _on_always_on_top_toggled(toggled_on: bool) -> void:
	var main_node = get_tree().current_scene
	if main_node and main_node.has_method(\"set_always_on_top\"):
		main_node.set_always_on_top(toggled_on)  # 由 Main 改 flag 并持久化
	else:
		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_ALWAYS_ON_TOP, toggled_on)
"

